[Desktop Entry]
Type=Application
Name=Windows
Comment=Open the Windows virtual machine
Exec=sh -c "if ! virsh -c qemu:///system domstate windows | grep -qx running; then virsh -c qemu:///system start windows; fi; exec virt-viewer -c qemu:///system windows"
Icon=windows-vm
Terminal=false
Categories=System;Emulator;
StartupNotify=true
