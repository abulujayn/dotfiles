# Keep all per-user Zsh configuration under XDG config.
export ZDOTDIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

# Prevent NixOS's generated global Zsh startup files from reintroducing the
# system-managed shell configuration after this dotfiles setup is installed.
setopt no_global_rcs

